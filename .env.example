# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey... (your anon key)

# Canonical public URL of the deployed site (used by the sitemap).
# Defaults to https://theatlantalist.com when unset.
NEXT_PUBLIC_SITE_URL=https://theatlantalist.com

# OPTIONAL: if you run the seed against RLS policies that demand the service role key
# SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL: payments readiness (leave blank until you set up Stripe)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
